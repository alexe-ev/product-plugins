{
  "eval_id": 1,
  "eval_name": "complete-inputs",
  "prompt": "Food delivery: click-to-order rate, baseline 7.8%, MDE +0.8pp, 95%/80%, 35k/week eligible",
  "assertions": [
    {
      "name": "sample_size_per_group",
      "expected": 117752,
      "operator": "equals",
      "description": "Sample size per group (50/50 split)"
    },
    {
      "name": "total_sample_size",
      "expected": 235504,
      "operator": "equals",
      "description": "Total sample size across both groups"
    },
    {
      "name": "test_duration_weeks",
      "expected": 6.73,
      "operator": "approximately_equals",
      "tolerance": 0.1,
      "description": "Required test duration in weeks (235504 / 35000)"
    },
    {
      "name": "baseline_conversion",
      "expected": 0.078,
      "operator": "equals",
      "description": "Baseline conversion rate"
    },
    {
      "name": "treatment_conversion",
      "expected": 0.086,
      "operator": "equals",
      "description": "Expected treatment conversion rate"
    },
    {
      "name": "relative_lift",
      "expected": 0.1026,
      "operator": "approximately_equals",
      "tolerance": 0.001,
      "description": "Relative lift percentage"
    },
    {
      "name": "feasibility",
      "expected": "feasible",
      "operator": "equals",
      "description": "Test is feasible with given traffic"
    }
  ],
  "calculation_method": "two-proportion z-test",
  "statistical_power": 0.80,
  "confidence_level": 0.95,
  "test_type": "two-sided",
  "split": "50/50"
}
